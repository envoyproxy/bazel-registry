diff --git a/bazel/BUILD b/bazel/BUILD
index 58b4aed..3c21a1e 100644
--- a/bazel/BUILD
+++ b/bazel/BUILD
@@ -13,60 +13,101 @@
 # limitations under the License.
 
 load("@bazel_skylib//lib:selects.bzl", "selects")
+load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
 load(":v8_transition.bzl", "v8_lib_no_pointer_compression")
 
 package(default_visibility = ["//visibility:public"])
 
+# Engine selection flag, replacing the legacy --define engine=<value>.
+# Values:
+#   v8          - V8 Wasm engine (default)
+#   wamr        - WebAssembly Micro Runtime, interpreter mode
+#   wamr-interp - WebAssembly Micro Runtime, interpreter mode
+#   wamr-jit    - WebAssembly Micro Runtime, JIT mode
+#   wasmtime    - Wasmtime engine
+#   wasmedge    - WasmEdge engine
+#   null        - Null (no-op) engine
+#   disabled    - No engine; disables all wasm functionality
+#   multi       - Multiple engines
+string_flag(
+    name = "engine",
+    build_setting_default = "v8",
+    values = [
+        "v8",
+        "wamr",
+        "wamr-interp",
+        "wamr-jit",
+        "wasmtime",
+        "wasmedge",
+        "null",
+        "disabled",
+        "multi",
+    ],
+)
+
 config_setting(
     name = "engine_null",
-    values = {"define": "engine=null"},
+    flag_values = {"//bazel:engine": "null"},
 )
 
 config_setting(
     name = "engine_v8",
-    values = {"define": "engine=v8"},
+    flag_values = {"//bazel:engine": "v8"},
 )
 
+# engine_wamr_interp matches both "wamr-interp" and the generic "wamr" alias.
 config_setting(
+    name = "_engine_wamr_interp_strict",
+    flag_values = {"//bazel:engine": "wamr-interp"},
+)
+
+config_setting(
+    name = "engine_wamr",
+    flag_values = {"//bazel:engine": "wamr"},
+)
+
+selects.config_setting_group(
     name = "engine_wamr_interp",
-    values = {"define": "engine=wamr-interp"},
+    match_any = [
+        ":_engine_wamr_interp_strict",
+        ":engine_wamr",
+    ],
 )
 
 config_setting(
     name = "engine_wamr_jit",
-    values = {"define": "engine=wamr-jit"},
+    flag_values = {"//bazel:engine": "wamr-jit"},
 )
 
 config_setting(
     name = "engine_wasmedge",
-    values = {"define": "engine=wasmedge"},
+    flag_values = {"//bazel:engine": "wasmedge"},
 )
 
 config_setting(
     name = "engine_wasmtime",
-    values = {"define": "engine=wasmtime"},
+    flag_values = {"//bazel:engine": "wasmtime"},
 )
 
 config_setting(
     name = "multiengine",
-    values = {"define": "engine=multi"},
+    flag_values = {"//bazel:engine": "multi"},
 )
 
 config_setting(
-    name = "requested_crypto_system",
-    values = {"define": "crypto=system"},
+    name = "engine_disabled",
+    flag_values = {"//bazel:engine": "disabled"},
 )
 
 config_setting(
-    name = "linux_s390x",
-    values = {"cpu": "s390x"},
+    name = "requested_crypto_system",
+    values = {"define": "crypto=system"},
 )
 
 selects.config_setting_group(
     name = "crypto_system",
     match_any = [
         ":requested_crypto_system",
-        ":linux_s390x",
     ],
 )
 
@@ -78,3 +119,45 @@ v8_lib_no_pointer_compression(
 )
 
 exports_files(["tsan_suppressions.txt"])
+# Crypto library dependency - can be overridden by consuming repos
+# Default: @boringssl//:crypto
+# Can be overriden, eg:
+#   --@proxy_wasm_cpp_host//bazel:crypto_lib=@boringssl-fips//:crypto
+#   --@proxy_wasm_cpp_host//bazel:crypto_lib=@envoy//bazel:boringcrypto
+#   --@proxy_wasm_cpp_host//bazel:crypto_lib=@some-other-ssl//:crypto
+label_flag(
+    name = "crypto_lib",
+    build_setting_default = "@boringssl//:crypto",
+)
+
+# WAMR library - can be overridden by consuming repos
+# Default: @com_github_bytecodealliance_wasm_micro_runtime//:wamr_lib
+# Override example: --@proxy_wasm_cpp_host//bazel:wamr_lib=@envoy//bazel/foreign_cc:wamr
+label_flag(
+    name = "wamr_lib",
+    build_setting_default = "@com_github_bytecodealliance_wasm_micro_runtime//:wamr_lib",
+)
+
+# Wasmtime library - can be overridden by consuming repos
+label_flag(
+    name = "wasmtime_lib",
+    build_setting_default = "@com_github_wasmtime//:wasmtime_lib",
+)
+
+# Prefixed wasmtime library (for multi-engine builds)
+label_flag(
+    name = "prefixed_wasmtime_lib",
+    build_setting_default = "@com_github_wasmtime//:prefixed_wasmtime_lib",
+)
+
+# WasmEdge library - can be overridden by consuming repos
+label_flag(
+    name = "wasmedge_lib",
+    build_setting_default = "@com_github_wasmedge_wasmedge//:wasmedge_lib",
+)
+
+# V8/wee8 library - can be overridden by consuming repos
+label_flag(
+    name = "v8_engine",
+    build_setting_default = "//bazel:wee8_no_pointer_compression",
+)
