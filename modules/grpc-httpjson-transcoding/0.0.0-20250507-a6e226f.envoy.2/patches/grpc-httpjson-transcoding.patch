+TEST_F(PathMatcherTest, CustomVerbDoesNotCollideWithHttpMethod) {
+  SetMatchUnregisteredCustomVerb(true);
+  MethodInfo* delete_shelf = AddPath("DELETE", "/v1/shelves/{shelf}");
+  MethodInfo* cancel_shelf = AddPath("POST", "/v1/shelves/{shelf}:cancel");
+  Build();
+
+  EXPECT_NE(nullptr, delete_shelf);
+  EXPECT_NE(nullptr, cancel_shelf);
+
+  VariableBindings bindings;
+  EXPECT_EQ(Lookup("D", "/v1/shelves/100:ELETE", &bindings), nullptr);
+  EXPECT_EQ(LookupNoBindings("D", "/v1/shelves/100:ELETE"), nullptr);
+  EXPECT_EQ(Lookup("POST:cancel", "/v1/shelves/100", &bindings), nullptr);
+  EXPECT_EQ(LookupNoBindings("POST:cancel", "/v1/shelves/100"), nullptr);
+  EXPECT_EQ(Lookup("DELETE", "/v1/shelves/100", &bindings), delete_shelf);
+  EXPECT_EQ(Lookup("POST", "/v1/shelves/100:cancel", &bindings), cancel_shelf);
+}
+
+TEST_F(PathMatcherTest, TrailingSlashDoesNotMatchWithoutTrailingSlash) {
+  MethodInfo* get_shelf = AddGetPath("/v1/shelves/{shelf}");
+  MethodInfo* ab = AddGetPath("/a/b");
+  Build();
+
+  EXPECT_NE(nullptr, get_shelf);
+  EXPECT_NE(nullptr, ab);
+
+  VariableBindings bindings;
+  EXPECT_EQ(Lookup("GET", "/v1/shelves/100/", &bindings), nullptr);
+  EXPECT_EQ(LookupNoBindings("GET", "/v1/shelves/100/"), nullptr);
+  EXPECT_EQ(LookupNoBindings("GET", "/a/b/"), nullptr);
+  EXPECT_EQ(Lookup("GET", "/v1/shelves/100", &bindings), get_shelf);
+  EXPECT_EQ(LookupNoBindings("GET", "/a/b"), ab);
+}
+
+TEST_F(PathMatcherTest, SingleSegmentBindingPreservesReservedPercentEncoding) {
+  MethodInfo* get_shelf = AddGetPath("/v1/shelves/{shelf}");
+  Build();
+
+  EXPECT_NE(nullptr, get_shelf);
+
+  VariableBindings bindings;
+  EXPECT_EQ(Lookup("GET", "/v1/shelves/%2B100", &bindings), get_shelf);
+  EXPECT_EQ(VariableBindings({
+                VariableBinding{FieldPath{"shelf"}, "%2B100"},
+            }),
+            bindings);
+}
